# 学习状态监测系统 · 阶段一 云端环境变量示例
# 复制为 .env 并修改：cp .env.example .env

# 设备密钥（必须与固件 config.h 中的 DEVICE_KEY 一致）
DEVICE_KEY=CHANGE_ME_DEVICE_KEY

# OpenVINO 模型目录
MODEL_DIR=yolov8n-pose_openvino_model

# 人体检测置信度阈值
CONF_THRESHOLD=0.5

# 姿态判定阈值（由 calibrate.py 标定后调整）
# 头高下限：低于此值判为低头/驼背
# ⚠️ 已按实测标定（坐直 0.68 / 驼背 0.21）；默认 0.15 会导致必然误报
HEAD_HEIGHT_MIN=0.37
# 肩平差上限：高于此值判为侧歪
SHOULDER_LEVEL_MAX=0.03

# ============================================================
# 多态检测（多个 AI API 分开工作）· 可选增强层
# ------------------------------------------------------------
# 默认关闭，不影响阶段一验收。开启后启用"慢速通道"：
#   AI-1  Qwen-VL  : 图像获取 / 视觉分析（看图 → 结构化视觉描述）
#   AI-2  DeepSeek : 行为分析 / 决策（读描述 → 行为判定 + action）
# 与本地 YOLOv8-pose"快速通道"融合，任一判定不端正即触发提醒。
# 对应文档 D11：Qwen 能力属阶段二，此处以可开关方式接入。
# ============================================================

# 总开关：true 启用多态检测慢速通道
MULTIMODAL_ENABLED=false

# AI-1 通义千问视觉模型（DashScope 兼容模式）
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-plus

# AI-2 DeepSeek 文本模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 慢速通道抽查周期（秒），建议 30~60，避免 API 费用过高
MULTIMODAL_INTERVAL=30
